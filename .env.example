# ---- Database -------------------------------------------------------------
# PostgreSQL connection string used by Prisma at runtime.
DATABASE_URL=

# Separate database used only by the integration test suite.
# MUST NOT point at development, staging or production.
TEST_DATABASE_URL=

# ---- Authentication -------------------------------------------------------
# 32+ byte random string. Generate with: openssl rand -base64 48
AUTH_SECRET=

# Minutes of inactivity before a session is considered idle-expired.
SESSION_IDLE_TIMEOUT_MINUTES=60
# Absolute session lifetime in hours, regardless of activity.
SESSION_ABSOLUTE_TIMEOUT_HOURS=12

# ---- Optional: enterprise SSO (OAuth 2.0 / OIDC) --------------------------
# Leave blank to run with local password + TOTP authentication only.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# ---- Application ----------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info
